{
  "$comment": "ELTA CRM — delt Claude Code permission-politik. Praecedens: deny > ask > allow. Aendr kun via review. Se docs/agent-core-architecture.md for kontekst. Tokens hoerer KUN til i .env.local (gitignored). AUTO_CREATE_CASES_ENABLED maa aldrig saettes til 'true' af en agent.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase migration up:*)",
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(rmdir:*)",
      "Bash(Remove-Item:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(npx tsx:*)",
      "Bash(node:*)",
      "Bash(npx ts-node:*)",
      "Bash(supabase:*)",
      "Bash(npx supabase:*)",
      "Bash(curl:*)",
      "Bash(powershell -Command:*)",
      "Bash(npm install:*)"
    ],
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next build:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(dir:*)",
      "Bash(where:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ]
  }
}
